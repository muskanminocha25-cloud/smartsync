APP_NAME=SmartSync
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=generate_with_python_secrets_token_hex_32

DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

GROQ_API_KEY=gsk_your_key_here
